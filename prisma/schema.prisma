// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id              String   @id @default(uuid())
  name            String
  description     String
  category        String
  imageUrl        String?
  documentUrl     String?  // Optional attached document (PDF, Excel, Word etc.)
  documentTitle   String?  // Display name for the document
  documentType    String?  // pdf | xlsx | docx | pptx | other
  isFeatured      Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model HeroSlide {
  id          String   @id @default(uuid())
  imageUrl    String
  title       String?
  description String?
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model SiteSetting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}

model User {
  id               String    @id @default(uuid())
  email            String    @unique
  password         String
  name             String?
  resetToken       String?   @unique
  resetTokenExpiry DateTime?
  createdAt        DateTime  @default(now())
}

model Partner {
  id        String   @id @default(uuid())
  name      String
  imageUrl  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Document {
  id             String   @id @default(uuid())
  title          String
  description    String?
  fileUrl        String
  fileType       String   // pdf | xlsx | docx | pptx | other
  coverImageUrl  String?
  order          Int      @default(0)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model CustomManufacturingItem {
  id                      String   @id @default(uuid())
  title                   String
  slug                    String   @unique
  shortDescription        String
  description             String
  usageArea               String?
  applicationArea         String?
  technicalSpecifications Json     @default("[]")
  projectNotes            String?
  coverImage              String?
  galleryImages           Json     @default("[]")
  videoUrl                String?
  featured                Boolean  @default(false)
  published               Boolean  @default(false)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  @@index([published])
  @@index([featured])
  @@index([createdAt])
}

model ServiceRequest {
  id                 String         @id @default(uuid())
  customerName       String
  companyName        String
  phone              String
  email              String
  deviceType         String
  brand              String
  model              String
  serialNumber       String?
  problemDescription String
  note               String?
  images             Json           @default("[]")
  status             String         @default("NEW")
  serviceRecord      ServiceRecord? @relation("RequestToRecord")
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  @@index([createdAt])
  @@index([status])
}

model ServiceRecord {
  id                      String          @id @default(uuid())
  trackingCode            String          @unique
  customerName            String
  companyName             String
  phone                   String
  email                   String
  deviceType              String
  brand                   String
  model                   String
  serialNumber            String?
  problemDescription      String
  receivedDate            DateTime
  estimatedCompletionDate DateTime?
  status                  String
  technicianNote          String?
  customerNote            String?
  images                  Json            @default("[]")
  serviceHistory          Json            @default("[]")
  sourceRequestId         String?         @unique
  sourceRequest           ServiceRequest? @relation("RequestToRecord", fields: [sourceRequestId], references: [id])
  createdAt               DateTime        @default(now())
  updatedAt               DateTime        @updatedAt

  @@index([receivedDate])
  @@index([status])
}
